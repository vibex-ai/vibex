/target/
node_modules/
dist/
apps/*/dist/
apps/mobile-nsh/android/.gradle/
apps/mobile-nsh/android/**/build/
apps/mobile-nsh/android/local.properties
apps/mobile-nsh/android/app/src/main/jniLibs/
# The nsh iOS host: the project is generated from `ios/project.yml`, and the
# static library `scripts/build-ios-host.sh` merges land in `ios/Frameworks/`.
apps/mobile-nsh/ios/*.xcodeproj/
apps/mobile-nsh/ios/Frameworks/
apps/mobile-nsh/ios/.xcodegen/
apps/mobile-nsh/artifacts/
crates/core/bindings/
*.tsbuildinfo
.idea/
/.vibex/
/.pnpm-store/
/coverage/
*.log
*.tmp
# `makepkg` run inside packaging/aur/<pkg> leaves its downloaded sources, its
# extracted tree, and the built package beside a PKGBUILD that IS tracked.
packaging/aur/*/src/
packaging/aur/*/pkg/
packaging/aur/*/*.pkg.tar.*
packaging/aur/*/*.deb
packaging/aur/*/vibex-*
# Backup copies left behind by patch/merge/edit tooling. A stray copy of a
# source file must never reach the public repository.
*.orig
*.rej
*.db
*.db-shm
*.db-wal

# `nix build` leaves this symlink in the repository root.
/result
/result-*

# Local controlled-environment E2E state (credentials, harness homes, relay logs)
.e2e-local-env/

# Local deployment environment files. The deploy compose files interpolate
# ${VAR:-default}, so an operator keeps image tags, bind addresses, TLS paths,
# and push-adapter tokens in a project .env; none of it may reach the public
# repository. A committed example file stays trackable.
.env
.env.*
!.env.example

# Private Trellis task tree. These paths live in the working tree but belong to a
# separate task repository (git dir .trellis/.taskgit, work tree .trellis).
# The rules must stay in THIS file rather than .trellis/.gitignore: the task
# repository's work tree starts at .trellis/, so it never reads this file, while
# a .gitignore inside .trellis/ would hide the very files it has to track.
/.trellis/tasks/
/.trellis/research/
/.trellis/workspace/*/
/.trellis/.current-task
/.trellis/.runtime/
/.trellis/.taskgit/
