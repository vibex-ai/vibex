{
  "name": "@vibex/mobile",
  "version": "0.1.0-rc.1",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "android:debug": "node scripts/build-android-debug.mjs",
    "android:release": "node scripts/build-android-debug.mjs --release",
    "build": "pnpm run validate",
    "cap": "cap",
    "copy": "pnpm run runtime:build && cap copy",
    "ios:debug": "node scripts/build-ios.mjs",
    "ios:release": "node scripts/build-ios.mjs --release",
    "sync": "pnpm run runtime:build && cap sync",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm run typecheck && pnpm run runtime:build",
    "runtime:build": "pnpm --filter @vibex/mobile-wasm build"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/barcode-scanner": "3.1.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "capacitor-secure-storage-plugin": "0.13.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "typescript": "^5.9.3"
  }
}
