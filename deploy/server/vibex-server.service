[Unit]
Description=Vibex headless runtime (vibex-server)
Documentation=https://github.com/vibex-ai/vibex
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=vibex
Group=vibex
ExecStart=/usr/local/bin/vibex-server serve
Restart=on-failure
RestartSec=3

# State lives in the user's home; ProtectHome=read is incompatible with it.
StateDirectory=vibex-server
WorkingDirectory=/var/lib/vibex-server
Environment=VIBEX_HOME=/var/lib/vibex-server
Environment=VIBEX_DB_PATH=/var/lib/vibex-server/vibex.db
Environment=VIBEX_BIND_ADDR=127.0.0.1:8765
Environment=VIBEX_DEPLOYMENT_MODE=loopback
Environment=VIBEX_TLS_MODE=loopback_http
Environment=VIBEX_APPLICATION_ID=dev.vibex.server
#EnvironmentFile=/etc/default/vibex-server

# Hardening: the runtime only needs its own state, a bind socket, and the
# agent CLIs it manages (which run as this same user outside the sandbox).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vibex-server
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
