{
  description = "Vibex: local-first AI coding workbench, packaged from the official Linux release binaries";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

  outputs =
    { self, nixpkgs }:
    let
      # The stable release this flake installs. `scripts/publish-nix.mjs`
      # rewrites this line and the `debHashes` table below on every stable
      # release, so the flake never builds Vibex from source and never installs
      # a payload the release workflow did not already publish.
      version = "0.1.9";

      # SHA-256 (Nix SRI form) of the `.deb` assets attached to
      # https://github.com/vibex-ai/vibex/releases/tag/v<version>.
      # Regenerated by `scripts/publish-nix.mjs`; `nix flake check` fails when a
      # payload drifts from these bytes.
      debHashes = {
        x86_64-linux = "sha256-9SgU22unfOQunQ51Dh7eU7FA8alje290Eoh1NjcsCws=";
        aarch64-linux = "sha256-Cu3eyAW3Xq84MexxdTWN86aCCrYNnIH6xyo3m1wfyVQ=";
      };

      systems = [
        "x86_64-linux"
        "aarch64-linux"
      ];

      mkPackage =
        system:
        let
          pkgs = nixpkgs.legacyPackages.${system};
          inherit (pkgs) lib;

          arch =
            {
              x86_64-linux = "x86_64";
              aarch64-linux = "aarch64";
            }
            .${system};

          # The release .deb is the only input. Vibex publishes Rust binaries
          # built by the tagged release workflow; rebuilding them here would
          # produce different bytes and a second, unverified artifact.
          src = pkgs.fetchurl {
            url = "https://github.com/vibex-ai/vibex/releases/download/v${version}/vibex-${version}-linux-${arch}-deb.deb";
            hash = debHashes.${system};
          };
          desktopItem = pkgs.makeDesktopItem {
            name = "vibex-desktop";
            desktopName = "Vibex";
            genericName = "AI Coding Workbench";
            comment = "Local-first AI coding workbench: Agent sessions, Git, terminals, and previews";
            exec = "vibex-desktop %U";
            tryExec = "vibex-desktop";
            icon = "vibex-desktop";
            terminal = false;
            categories = [
              "Development"
              "Utility"
            ];
            keywords = [
              "ai"
              "agent"
              "coding"
              "git"
              "editor"
              "terminal"
            ];
            startupWMClass = "dev.vibex.desktop";
          };
        in
        pkgs.stdenv.mkDerivation {
          pname = "vibex";
          inherit version src;

          nativeBuildInputs = with pkgs; [
            # The payload is a dynamically linked ELF tree: autoPatchelfHook
            # rewrites the interpreter and RPATH to Nix store paths, which is
            # the difference between running on NixOS and on a distribution that
            # still has /lib64/ld-linux-x86-64.so.2.
            autoPatchelfHook
            # GTK 3 loads its GIO modules, pixbuf loaders and schemas through
            # environment variables, so the desktop entry is launched through a
            # wrapper that points them into the store.
            wrapGAppsHook3
            makeWrapper
            # `bsdtar` reads the ar archive a .deb is, then its xz payload.
            libarchive
          ];

          buildInputs = with pkgs; [
            dbus
            fontconfig
            freetype
            gdk-pixbuf
            glib
            gsettings-desktop-schemas
            gtk3
            libxcb
            libxkbcommon
            libglvnd
            stdenv.cc.cc.lib
            systemd
            vulkan-loader
            wayland
          ];

          # Besides the NEEDED entries autoPatchelfHook resolves from
          # buildInputs, several libraries are opened by name at runtime, and a
          # dlopen only consults the caller's RUNPATH:
          #
          #  - GPUI's wgpu backend loads libvulkan (the loader for the host's
          #    ICDs) and libEGL from libglvnd, whose default vendor path is
          #    /run/opengl-driver on NixOS, so the host Mesa/NVIDIA driver is
          #    used instead of a bundled one.
          #  - The Wayland backend loads the libwayland client libraries.
          #  - The X11 backend loads libX11 and its extensions directly.
          #  - XKB keymaps come from libxkbcommon, which reads them through
          #    xkeyboard-config.
          #
          # `runtimeDependencies` is what puts those paths on the RUNPATH, so
          # they resolve without the user setting LD_LIBRARY_PATH. fontconfig
          # and freetype are listed for the same reason: GPUI builds its font
          # database through them, and the payload only reaches them through
          # GTK otherwise. The font *configuration* stays the host's: NixOS
          # supplies /etc/fonts through its own fontconfig module, and forcing
          # a store path here would hide the fonts the user declared.
          #
          # OpenSSL is deliberately absent: the binary carries a vendored
          # rustls/crypto stack (there is no libssl or libcrypto in `ldd`), so
          # adding it would install a library nothing loads.
          runtimeDependencies = with pkgs; [
            fontconfig
            freetype
            libglvnd
            libxcb
            libxkbcommon
            libx11
            libxext
            libxfixes
            libxrender
            libxcursor
            libxrandr
            libxi
            libxinerama
            libxcomposite
            libxdamage
            vulkan-loader
            wayland
          ];

          # The published ELF payload is already stripped and reviewed; keep
          # fixup from rewriting it beyond the patchelf step.
          dontStrip = true;
          # Only the GUI needs the GTK/GIO/GDK-PixBuf environment. Wrapping the
          # terminal client with it would put a GTK environment in front of a
          # character-grid program that never touches GTK, so the hook is
          # switched off and `postFixup` wraps the desktop binary itself.
          dontWrapGApps = true;

          unpackPhase = ''
            runHook preUnpack
            mkdir -p source unpacked
            ${pkgs.libarchive}/bin/bsdtar --extract --file "$src" --directory unpacked
            payload=$(find unpacked -maxdepth 1 -name 'data.tar.*' -print -quit)
            test -n "$payload"
            ${pkgs.libarchive}/bin/bsdtar --extract --file "$payload" --directory source
            runHook postUnpack
          '';

          sourceRoot = "source";

          dontConfigure = true;
          dontBuild = true;
          dontPatch = true;

          # Keep the layout the GUI resolves PDFium from: it looks for
          # `../lib/vibex-desktop/pdfium/lib/libpdfium.so` next to its own
          # binary, exactly as the .deb, AUR, RPM and AppImage packages ship it.
          installPhase = ''
            runHook preInstall
            mkdir -p "$out/bin" "$out/lib" "$out/share/icons"
            install -m755 usr/bin/vibex-desktop usr/bin/vibex usr/bin/vibex-tui "$out/bin/"
            # The aarch64 release carries no PDFium payload (its distribution
            # approval covers linux-x86_64 only), so this copy is optional.
            if [ -d usr/lib/vibex-desktop ]; then
              cp -a usr/lib/vibex-desktop "$out/lib/"
            fi
            cp -a usr/share/icons/hicolor "$out/share/icons/"
            runHook postInstall
          '';

          postInstall = ''
            install -Dm644 ${desktopItem}/share/applications/vibex-desktop.desktop \
              "$out/share/applications/vibex-desktop.desktop"
          '';

          postFixup = ''
            wrapGApp "$out/bin/vibex-desktop"
          '';

          meta = {
            description = "Local-first AI coding workbench: Agent sessions, Git, terminals, and previews";
            homepage = "https://github.com/vibex-ai/vibex";
            downloadPage = "https://github.com/vibex-ai/vibex/releases";
            changelog = "https://github.com/vibex-ai/vibex/releases/tag/v${version}";
            mainProgram = "vibex-desktop";
            license = lib.licenses.agpl3Plus;
            sourceProvenance = [ lib.sourceTypes.binaryNativeCode ];
            platforms = systems;
          };
        };
    in
    {
      packages = nixpkgs.lib.genAttrs systems (system: {
        vibex = mkPackage system;
        default = mkPackage system;
      });

      apps = nixpkgs.lib.genAttrs systems (system: {
        vibex = {
          type = "app";
          program = "${self.packages.${system}.vibex}/bin/vibex-desktop";
          meta.description = "Launch the Vibex desktop application";
        };
        default = self.apps.${system}.vibex;
      });

      formatter = nixpkgs.lib.genAttrs systems (system: nixpkgs.legacyPackages.${system}.nixfmt);

      checks = nixpkgs.lib.genAttrs systems (system: {
        package = self.packages.${system}.vibex;
      });
    };
}
